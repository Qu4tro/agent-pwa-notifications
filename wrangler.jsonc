{
  // Forking? Replace account_id + the database_id/id below with your own
  // (from `wrangler d1 create agent-dash` and `wrangler kv namespace create SESSIONS`),
  // or just run `pnpm setup` which walks you through it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-pwa-notifications",
  "account_id": "f4d71022dd6ed8ada4e294c096d51fc5",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Instant mode is OFF by default: the app polls (free tier, no DO usage).
  // Flip INSTANT to "1" (and keep the binding below) for sub-second live updates
  // via a hibernating Durable Object. A SQLite-backed class is free-plan eligible.
  // EVENT_RETENTION_DAYS: the hourly cron archives events older than this.
  // Archived means out of the app, still in the database - nothing is deleted.
  // SESSION_TTL_DAYS: how long a signed-in browser stays signed in. Long, so a
  // notification answer button still works weeks later.
  "vars": {
    "INSTANT": "0",
    "EVENT_RETENTION_DAYS": "90",
    "SESSION_TTL_DAYS": "365"
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-dash",
      "database_id": "40bec5c6-4077-4c43-a615-860181b6b766"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "27cc01d4724a41a39be9e0201685a36c"
    }
  ]
}
